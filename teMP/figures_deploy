#!/usr/bin/env python3
"""Deploy experiment figures with deterministic handling of duplicate names.

The manifest maps a source filename to experiment-specific deployed names:

figures:
  figure.pdf:
    experiment_a: figure__experiment_a.pdf
    experiment_b: figure__experiment_b.pdf

Usage:
    figures_deploy SOURCE_ROOT DEST_ROOT [--manifest PATH]

SOURCE_ROOT should contain experiment directories. Each experiment directory
is expected to contain the figure files to deploy.
"""

from __future__ import annotations

import argparse
import shutil
from pathlib import Path

try:
    import yaml
except ImportError as exc:
    raise SystemExit(
        "PyYAML is required: python -m pip install pyyaml"
    ) from exc


def load_manifest(path: Path) -> dict[str, dict[str, str]]:
    if not path.exists():
        raise SystemExit(f"manifest not found: {path}")

    with path.open() as fh:
        data = yaml.safe_load(fh) or {}

    figures = data.get("figures", {})
    if not isinstance(figures, dict):
        raise SystemExit("manifest key 'figures' must be a mapping")

    return figures


def deployed_name(manifest, filename: str, experiment: str) -> str:
    mapping = manifest.get(filename, {})
    if not isinstance(mapping, dict):
        raise SystemExit(f"invalid manifest entry for {filename!r}")

    return mapping.get(experiment, filename)


def deploy(source_root: Path, dest_root: Path, manifest_path: Path) -> int:
    manifest = load_manifest(manifest_path)
    copied = 0

    if not source_root.is_dir():
        raise SystemExit(f"source root not found: {source_root}")

    dest_root.mkdir(parents=True, exist_ok=True)

    # Each immediate child is an experiment/source directory.
    for experiment_dir in sorted(p for p in source_root.iterdir() if p.is_dir()):
        experiment = experiment_dir.name

        for src in sorted(p for p in experiment_dir.rglob("*") if p.is_file()):
            # Preserve the existing filename for non-colliding figures.
            # The manifest only changes explicitly listed filenames.
            name = deployed_name(manifest, src.name, experiment)
            dst = dest_root / name

            if dst.exists():
                # Never silently overwrite a different producer.
                existing = dst.resolve()
                source = src.resolve()
                if existing != source:
                    raise SystemExit(
                        f"deployment collision: {dst} is already occupied "
                        f"while deploying {src} from {experiment}"
                    )

            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            copied += 1

    return copied


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source_root", type=Path)
    parser.add_argument("dest_root", type=Path)
    parser.add_argument(
        "--manifest",
        type=Path,
        default=Path("scripts/figures_manifest.yml"),
    )
    args = parser.parse_args()

    count = deploy(args.source_root, args.dest_root, args.manifest)
    print(f"deployed {count} figure file(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
