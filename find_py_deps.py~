#!/usr/bin/env python3
"""
find_py_deps.py — find every .py file referenced from .github/workflows
and run_all.sh, then recursively trace each one's local (in-repo) Python
import dependencies.

Usage:
    python3 find_py_deps.py [REPO_ROOT]
    python3 find_py_deps.py [REPO_ROOT] --workflow ci_pipeline_public.yml
    python3 find_py_deps.py [REPO_ROOT] --workflow ci_pipeline_public.yml --no-run-all

REPO_ROOT defaults to the current directory. The repo must contain:
    REPO_ROOT/.github/workflows/*   (yml/yaml/or any text files)
    REPO_ROOT/run_all.sh            (optional — skipped if absent)

Options:
    -w, --workflow NAME   Only scan this one workflow file (matched by
                           exact filename, e.g. ci_pipeline_public.yml,
                           or by filename without extension). Without
                           this flag, every file under .github/workflows/
                           is scanned.
    --no-run-all           Skip scanning run_all.sh — useful when you
                           want results isolated to a single workflow.
    -o, --output PATH      Where to write the JSON report
                           (default: ./py_deps_report.json)

Output:
    - Prints a human-readable report to stdout, including the list of
      actual subdirectories (relative to REPO_ROOT) that contain at
      least one touched .py file.
    - Writes a JSON report (entry points -> sorted list of every local
      .py file they transitively import, the combined union of all
      files touched, and the combined union of all directories touched).

Notes / limitations:
    - "Local" imports are those that resolve to a .py file or package
      inside REPO_ROOT. Anything resolving to an installed / stdlib
      package is ignored.
    - Only static `import x`, `import x.y as z`, `from x import y`,
      and relative `from . import y` / `from .x import y` forms are
      detected (via the ast module). Dynamic imports (importlib,
      __import__, exec) are not detected.
    - Path references in workflow/shell files are found via a regex
      that matches typical file-path tokens ending in `.py`.
"""

import argparse
import ast
import json
import os
import re
import sys
from pathlib import Path

PY_PATH_RE = re.compile(r'[A-Za-z0-9_./\-]+\.py\b')


def strip_unquoted_comment(line: str) -> str:
    """Truncate a line at the first '#' that is not inside a quoted string.

    Handles '#' and "#" quoting (good enough for Python/shell/YAML source,
    which is all this tool scans). Does NOT handle multi-line triple-quoted
    Python docstrings/strings — those are left as-is.
    """
    in_single = False
    in_double = False
    for i, ch in enumerate(line):
        if ch == "'" and not in_double:
            in_single = not in_single
        elif ch == '"' and not in_single:
            in_double = not in_double
        elif ch == "#" and not in_single and not in_double:
            return line[:i]
    return line


def strip_comments(content: str) -> str:
    """Strip '#'-style comments (whole-line and inline) from source text.

    Used before regex-scanning for file-path references, so that a
    filename merely *mentioned* in a comment (docs, changelog notes,
    disabled code, warnings about a related-but-separate pipeline) isn't
    treated the same as a real, live reference to that file.
    """
    return "\n".join(strip_unquoted_comment(line) for line in content.splitlines())


def find_py_references(text_file: Path) -> set[str]:
    """Return raw path-like strings ending in .py found in a text file.

    Comments (# ...) are stripped first so that filenames only mentioned
    in prose/comments don't get treated as real references.
    """
    try:
        content = text_file.read_text(errors="ignore")
    except OSError:
        return set()
    return set(PY_PATH_RE.findall(strip_comments(content)))


def resolve_reference(ref: str, repo_root: Path) -> Path | None:
    """Try to resolve a raw referenced path string to an actual file in the repo."""
    candidates = [
        repo_root / ref,
        repo_root / ref.lstrip("./"),
    ]
    # Also try matching just the basename anywhere in the repo, as a fallback
    for c in candidates:
        if c.is_file():
            return c.resolve()

    basename = os.path.basename(ref)
    matches = list(repo_root.rglob(basename))
    matches = [m for m in matches if m.is_file()]
    if len(matches) == 1:
        return matches[0].resolve()
    return None


def collect_entry_points(repo_root: Path, workflow_filter: str | None = None,
                          include_run_all: bool = True) -> dict[str, set[str]]:
    """Scan .github/workflows/* and run_all.sh for .py references.

    If workflow_filter is given, only that workflow file (matched by exact
    filename or filename with no extension) is scanned instead of every
    file under .github/workflows/.
    """
    sources: dict[str, set[str]] = {}

    workflows_dir = repo_root / ".github" / "workflows"
    if workflows_dir.is_dir():
        for wf in sorted(workflows_dir.iterdir()):
            if not wf.is_file():
                continue
            if workflow_filter and wf.name != workflow_filter and wf.stem != workflow_filter:
                continue
            refs = find_py_references(wf)
            if refs:
                sources[str(wf.relative_to(repo_root))] = refs

    if include_run_all:
        run_all = repo_root / "run_all.sh"
        if run_all.is_file():
            refs = find_py_references(run_all)
            if refs:
                sources[str(run_all.relative_to(repo_root))] = refs

    return sources


def module_to_file(module: str, repo_root: Path) -> Path | None:
    """Resolve a dotted module name (e.g. 'pkg.sub.mod') to a repo-local file."""
    parts = module.split(".")
    base = repo_root.joinpath(*parts)
    candidate_file = base.with_suffix(".py")
    if candidate_file.is_file():
        return candidate_file.resolve()
    candidate_pkg = base / "__init__.py"
    if candidate_pkg.is_file():
        return candidate_pkg.resolve()
    return None


def module_to_file_in_dir(pkg_dir: Path, name: str) -> Path | None:
    """Resolve `name` as a submodule/subpackage living inside pkg_dir."""
    candidate_file = pkg_dir / f"{name}.py"
    if candidate_file.is_file():
        return candidate_file.resolve()
    candidate_pkg = pkg_dir / name / "__init__.py"
    if candidate_pkg.is_file():
        return candidate_pkg.resolve()
    return None


def relative_import_to_file(py_file: Path, level: int, module: str | None, repo_root: Path) -> Path | None:
    """Resolve a relative import ('from . import x' / 'from .mod import y')."""
    pkg_dir = py_file.parent
    # level=1 -> current package, level=2 -> parent package, etc.
    for _ in range(level - 1):
        pkg_dir = pkg_dir.parent
    if module:
        target = pkg_dir.joinpath(*module.split("."))
    else:
        target = pkg_dir
    candidate_file = target.with_suffix(".py")
    if candidate_file.is_file():
        return candidate_file.resolve()
    candidate_pkg = target / "__init__.py"
    if candidate_pkg.is_file():
        return candidate_pkg.resolve()
    return None


def extract_imports(py_file: Path, repo_root: Path) -> set[Path]:
    """Parse a .py file's imports and return the set of local files they resolve to."""
    deps: set[Path] = set()
    try:
        tree = ast.parse(py_file.read_text(errors="ignore"), filename=str(py_file))
    except (SyntaxError, OSError):
        return deps

    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                resolved = module_to_file(alias.name, repo_root)
                if resolved and resolved != py_file:
                    deps.add(resolved)
        elif isinstance(node, ast.ImportFrom):
            if node.level and node.level > 0:
                # Resolve the base ('from .pkg import x' -> .pkg, or 'from . import x' -> current pkg)
                base = relative_import_to_file(py_file, node.level, node.module, repo_root)
                if base and base != py_file:
                    deps.add(base)
                # Also try each imported name as a submodule of the base package dir,
                # e.g. 'from . import sibling' or 'from .pkg import sibling'
                pkg_dir = py_file.parent
                for _ in range(node.level - 1):
                    pkg_dir = pkg_dir.parent
                if node.module:
                    pkg_dir = pkg_dir.joinpath(*node.module.split("."))
                for alias in node.names:
                    sub = module_to_file_in_dir(pkg_dir, alias.name)
                    if sub and sub != py_file:
                        deps.add(sub)
            elif node.module:
                base = module_to_file(node.module, repo_root)
                if base and base != py_file:
                    deps.add(base)
                # Also try each imported name as a submodule, e.g. 'from pkg import util'
                pkg_dir = repo_root.joinpath(*node.module.split("."))
                for alias in node.names:
                    sub = module_to_file_in_dir(pkg_dir, alias.name)
                    if sub and sub != py_file:
                        deps.add(sub)
    return deps


def trace_dependencies(entry_file: Path, repo_root: Path) -> set[Path]:
    """BFS over local imports starting from entry_file. Returns all local files reached
    (not including entry_file itself)."""
    seen: set[Path] = set()
    queue = [entry_file]
    visited_entries = {entry_file}
    while queue:
        current = queue.pop()
        for dep in extract_imports(current, repo_root):
            if dep not in seen:
                seen.add(dep)
            if dep not in visited_entries:
                visited_entries.add(dep)
                queue.append(dep)
    return seen


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("repo_root", nargs="?", default=".", help="Path to repo root (default: current dir)")
    parser.add_argument("-o", "--output", default="py_deps_report.json", help="JSON report output path")
    parser.add_argument("-w", "--workflow", default=None,
                         help="Only scan this workflow file (e.g. ci_pipeline_public.yml) "
                              "instead of every file in .github/workflows/")
    parser.add_argument("--no-run-all", action="store_true",
                         help="Skip scanning run_all.sh (useful when isolating a single workflow)")
    args = parser.parse_args()

    repo_root = Path(args.repo_root).resolve()
    if not repo_root.is_dir():
        print(f"ERROR: {repo_root} is not a directory", file=sys.stderr)
        sys.exit(1)

    sources = collect_entry_points(repo_root, workflow_filter=args.workflow,
                                    include_run_all=not args.no_run_all)
    if not sources:
        print("No .py references found in .github/workflows or run_all.sh")

    # Resolve every referenced string to an actual file, tagged by where it was found
    entry_points: dict[str, str] = {}  # resolved relpath -> "found in" source(s)
    unresolved: dict[str, list[str]] = {}

    for source_file, refs in sources.items():
        for ref in sorted(refs):
            resolved = resolve_reference(ref, repo_root)
            if resolved:
                relpath = str(resolved.relative_to(repo_root))
                entry_points.setdefault(relpath, []).append(source_file)
            else:
                unresolved.setdefault(ref, []).append(source_file)

    report = {
        "repo_root": str(repo_root),
        "sources_scanned": sorted(sources.keys()),
        "entry_points": {},
        "unresolved_references": unresolved,
        "all_files_touched": [],
    }

    all_files: set[str] = set()

    print("=" * 70)
    print(f"Repo root: {repo_root}")
    print(f"Sources scanned: {', '.join(sorted(sources.keys())) or '(none found)'}")
    print("=" * 70)

    for relpath, found_in in sorted(entry_points.items()):
        entry_file = repo_root / relpath
        deps = trace_dependencies(entry_file, repo_root)
        dep_relpaths = sorted(str(d.relative_to(repo_root)) for d in deps)

        all_files.add(relpath)
        all_files.update(dep_relpaths)

        report["entry_points"][relpath] = {
            "referenced_in": sorted(set(found_in)),
            "local_dependencies": dep_relpaths,
        }

        print(f"\nEntry point: {relpath}")
        print(f"  referenced in: {', '.join(sorted(set(found_in)))}")
        if dep_relpaths:
            print(f"  local dependencies ({len(dep_relpaths)}):")
            for d in dep_relpaths:
                print(f"    - {d}")
        else:
            print("  local dependencies: (none detected)")

    if unresolved:
        print(f"\nUnresolved references ({len(unresolved)}) — mentioned but no matching file found in repo:")
        for ref, found_in in sorted(unresolved.items()):
            print(f"  - {ref}  (in: {', '.join(sorted(set(found_in)))})")

    report["all_files_touched"] = sorted(all_files)

    # Directory-level rollup: every unique subdirectory (relative to repo_root)
    # containing at least one touched .py file.
    all_dirs = sorted({str(Path(f).parent) if Path(f).parent != Path(".") else "."
                        for f in all_files})
    report["all_dirs_touched"] = all_dirs

    print("\n" + "=" * 70)
    print(f"Total distinct .py files touched (entry points + dependencies): {len(all_files)}")
    print(f"Total distinct subdirectories touched: {len(all_dirs)}")
    for d in all_dirs:
        print(f"    - {d}")
    print("=" * 70)

    out_path = Path(args.output)
    out_path.write_text(json.dumps(report, indent=2))
    print(f"\nJSON report written to: {out_path.resolve()}")


if __name__ == "__main__":
    main()
