def merge_step_outputs(step: Step) -> None:
    """
    Run .github/scripts/merge_shards.py in-process after a step succeeds.

    Equivalent to what ci_experiment.yml's consolidate job does, but runs
    locally so every experiment's _merged.json / _merged.csv / _stats.json /
    _checkpoint.json are produced inside the single-machine pipeline too.

    Only fires when step.merge_shards is True.
    The input-root is the experiment's result_subdir (shards already moved
    there by move_step_outputs / post_move steps), and the output-dir is the
    same location so the four canonical files land beside the partial results.
    """
    if not step.merge_shards:
        return

    # Locate merge_shards.py: try the repo's .github/scripts/ first,
    # then the same directory as this script (for local copies).
    _candidates = [
        REPO_ROOT / ".github" / "scripts" / "merge_shards.py",
        Path(__file__).resolve().parent / ".github" / "scripts" / "merge_shards.py",
        Path(__file__).resolve().parent / "merge_shards.py",
    ]
    merge_script = next((p for p in _candidates if p.exists()), None)
    if merge_script is None:
        print(f"  ⚠  merge_shards.py not found for [{step.id}] — skipping merge step.")
        print(f"     Searched: {[str(c) for c in _candidates]}")
        return

    # Map step.id → EXP_RESULT_SUBDIR (same dict as EXP_RESULT_SUBDIR in this file)
    _subdir = EXP_RESULT_SUBDIR.get(step.id)
    if _subdir is None:
        # step not in the per-experiment map (setup/audit steps etc.) — skip silently
        return

    input_root = RESULTS_DIR / _subdir
    output_dir = RESULTS_DIR / _subdir

    print(f"│    merge_shards → [{step.id}]  subdir={_subdir}")

    # Import and call in-process (avoids subprocess overhead + inherits env)
    import importlib.util as _ilu
    _spec = _ilu.spec_from_file_location("merge_shards", merge_script)
    if _spec is None or _spec.loader is None:
        print(f"  ⚠  Could not import merge_shards.py for [{step.id}]")
        return
    _mod = _ilu.module_from_spec(_spec)
    try:
        _spec.loader.exec_module(_mod)  # type: ignore[union-attr]
    except Exception as _e:
        print(f"  ⚠  merge_shards import error for [{step.id}]: {_e}")
        return

    try:
        rc = _mod.merge_experiment(
            exp_id        = step.id,
            input_root    = input_root,
            output_dir    = output_dir,
            result_subdir = _subdir,
            run_id        = os.environ.get("GITHUB_RUN_ID", "local"),
            verbose       = True,
        )
        if rc == 0:
            print(f"│    ✅  merge_shards OK → {output_dir.relative_to(REPO_ROOT)}/_merged.json")
        else:
            print(f"│    ⚠  merge_shards returned non-zero for [{step.id}] — partial results only")
    except Exception as _e:
        print(f"│    ⚠  merge_shards error for [{step.id}]: {_e}")


